# ===== v1.0 隔离：中间产物与临时文件（绝不交付、不计入版本、不进仓库根） =====
/.tmp/
/build/

# ===== v1.0 源码工程内的依赖与构建输出（不纳入交付） =====
/src/node_modules/
/src/dist*/
/src/dist-single/

# ===== 交付物：单文件产物是构建输出，不纳入版本库 =====
# `npm run build:deliver` 会生成仓库根的 delivery/index-v1.html。
# 该文件改为通过 GitHub Release 作为附件分发（或手动上传），仓库只保留源码，保持轻量。
/delivery/

# 编辑器 / 系统 / 日志
.DS_Store
*.log
